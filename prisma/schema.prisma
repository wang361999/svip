generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  username         String        @unique
  password         String
  role             String        @default("user")
  membership       String        @default("free")
  membershipExpires String?
  strategyConfig   String?
  // 用户画线偏好
  prefAB9          String        @default("true")
  prefAutoFib      String        @default("false")
  prefAB9Labels    String        @default("true")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tradeRecords     TradeRecord[]
  priceAlerts      PriceAlert[]
}

model TradeRecord {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  side         String
  entryPrice   Float
  exitPrice    Float?
  stopLoss     Float?
  takeProfit1  Float?
  takeProfit2  Float?
  volume       Float
  status       String    @default("open")
  pnl          Float     @default(0)
  pnlPercent   Float     @default(0)
  strategy     String?
  note         String?
  timestamp    DateTime  @default(now())
  closedAt     DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String
  expiry    DateTime
  lastSent  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type])
}

model PriceAlert {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  condition    String
  targetPrice  Float
  note         String?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  triggeredAt  DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RedeemCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  days      Int
  used      Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([used])
}

model SiteSetting {
  id                     String   @id @default("main")
  // 基础信息
  siteTitle              String   @default("ETH Trading Tool")
  siteSubtitle           String   @default("Real-time Ethereum Trading Platform")
  siteLogo               String   @default("/logo.svg")
  footerText             String   @default("© 2024 ETH Trading Tool. All rights reserved.")
  primaryColor           String   @default("#3b82f6")
  // 指标开关
  indicatorMA            String   @default("true")
  indicatorEMA           String   @default("false")
  indicatorBOLL          String   @default("true")
  indicatorMACD          String   @default("true")
  indicatorRSI           String   @default("false")
  indicatorATR           String   @default("false")
  indicatorFIB           String   @default("false")
  indicatorTDSequential  String   @default("false")
  indicatorNAKED         String   @default("false")
  // 指标周期参数
  maPeriod               String   @default("50")
  emaPeriod              String   @default("20")
  bollPeriod             String   @default("20")
  rsiPeriod              String   @default("14")
  atrPeriod              String   @default("14")
  macdFast               String   @default("12")
  macdSlow               String   @default("26")
  macdSignal             String   @default("9")
  // 显示控制
  showPriceCard          String   @default("true")
  showFibPanel           String   @default("true")
  showMarketStructure    String   @default("true")
  showEntrySignal        String   @default("true")
  showExitSignal         String   @default("true")
  showGannAngle          String   @default("true")
  showNakedBullBear      String   @default("true")
  showFibDraw            String   @default("true")
  fibLabeled             String   @default("true")
  fibUnlabeled           String   @default("true")
  enableRegistration     String   @default("true")
  // SMTP 邮箱配置
  smtpHost               String?  @default("smtp.qq.com")
  smtpPort               String?  @default("465")
  smtpSecure             String?  @default("true")
  smtpUser               String?
  smtpPass               String?
  smtpFrom               String?
  // AB9 九线颜色配置
  ab9Line1Color          String   @default("rgba(100, 116, 139, 0.3)")
  ab9Line2Color          String   @default("rgba(100, 116, 139, 0.35)")
  ab9Line3Color          String   @default("rgba(239, 68, 68, 0.75)")
  ab9Line4Color          String   @default("rgba(148, 163, 184, 0.7)")
  ab9Line5Color          String   @default("rgba(34, 197, 94, 0.75)")
  ab9Line6Color          String   @default("rgba(100, 116, 139, 0.45)")
  ab9Line7Color          String   @default("rgba(100, 116, 139, 0.45)")
  ab9Line8Color          String   @default("rgba(148, 163, 184, 0.6)")
  ab9Line9Color          String   @default("rgba(168, 85, 247, 0.6)")
  // 模拟盘开关（后台控制）
  paperTradingEnabled    String   @default("false")
  // Cron 引擎配置
  cronLoops              String?  @default("1")    // 每次请求循环次数 (1-3)
  cronInterval           String?  @default("0")    // 循环间隔毫秒
  cronLogTtl             String?  @default("1")    // 日志保留小时数 (1-72)
  // AI 模型配置
  aiEnabled              String   @default("false")   // 是否启用 AI 分析
  aiProvider             String   @default("openai")  // 供应商: openai / deepseek / qwen / moonshot / custom
  aiApiUrl               String?                       // API 地址
  aiApiKey               String?                       // API Key
  aiModel                String?                       // 模型名称
  aiTemperature          String   @default("0.3")     // 温度参数 (0-2)
  aiMaxTokens            String   @default("4000")     // 最大 token 数
  aiAnalysisInterval     String   @default("1")        // 自动分析间隔（分钟，0=不自动，1=每分钟）
  aiAutoTrade            String   @default("false")    // AI 信号是否触发自动开仓

  updatedAt              DateTime @updatedAt
}

// ==================== 模拟盘（Paper Trading） ====================

model PaperAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  balance         Float    @default(100000)  // 总资产（USDT）
  available       Float    @default(100000)  // 可用保证金
  marginUsed      Float    @default(0)       // 已用保证金
  unrealizedPnl   Float    @default(0)       // 浮动盈亏
  realizedPnl     Float    @default(0)       // 已实现盈亏
  // 风控参数（用户可配置）
  leverage        Int      @default(10)      // 默认杠杆
  positionPct     Float    @default(10)      // 单笔仓位占比 %
  stopLossPct     Float    @default(2)       // 单笔风险占比 %
  takerFee        Float    @default(0.05)    // 吃单手续费 %
  makerFee        Float    @default(0.02)    // 挂单手续费 %
  slippage        Float    @default(0.05)    // 滑点 %
  autoTrade       Boolean  @default(false)   // 自动交易开关
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  positions       PaperPosition[]
  trades          PaperTrade[]
  logs            PaperTradeLog[]

  @@index([userId])
}

model PaperPosition {
  id            String   @id @default(cuid())
  accountId     String
  userId        String
  symbol        String                         // 交易对 e.g. ETHUSDT
  side          String                         // 'long' | 'short'
  entryPrice    Float
  quantity      Float                          // 仓位数量（币）
  leverage      Int
  margin        Float                          // 保证金
  stopLoss      Float?
  takeProfit1   Float?
  takeProfit2   Float?
  partialClosed Boolean  @default(false)       // 是否已部分平仓（止盈1）
  status        String   @default("open")      // 'open' | 'closed'
  strategyId    String?                        // 触发策略
  signalPrice   Float?                         // 信号入场价
  entryFee      Float    @default(0)           // 开仓手续费
  entrySlippage Float    @default(0)           // 开仓滑点成本
  currentPrice  Float    @default(0)           // 最近一次快照价（算浮盈用）
  unrealizedPnl Float    @default(0)           // 浮动盈亏
  unrealizedPnlPct Float  @default(0)          // 浮动盈亏%
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  closedAt      DateTime?

  account       PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trades        PaperTrade[]

  @@index([accountId])
  @@index([userId])
  @@index([status])
  @@index([symbol])
}

model PaperTrade {
  id            String   @id @default(cuid())
  positionId    String
  accountId     String
  userId        String
  symbol        String
  side          String                         // 'long' | 'short'
  entryPrice    Float
  exitPrice     Float
  quantity      Float
  leverage      Int
  margin        Float
  pnl           Float                          // 盈亏（USDT，扣费后）
  pnlPercent    Float                          // 盈亏% (基于保证金)
  fee           Float                          // 平仓手续费
  slippage      Float                          // 平仓滑点成本
  totalCost     Float                          // 开仓+平仓总手续费+滑点
  duration      Int      @default(0)           // 持仓秒数
  closeReason   String                         // 'stop_loss' | 'take_profit_1' | 'take_profit_2' | 'manual' | 'auto'
  strategyId    String?
  createdAt     DateTime @default(now())
  closedAt      DateTime @default(now())

  position      PaperPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  account       PaperAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([userId])
  @@index([symbol])
}

model PaperTradeLog {
  id            String   @id @default(cuid())
  accountId     String
  userId        String
  action        String                         // 'open' | 'close' | 'partial_close' | 'config' | 'engine'
  symbol        String?
  detail        String                         // JSON 详情
  price         Float?
  createdAt     DateTime @default(now())

  account       PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([action])
}

// ==================== 交易币种管理 ====================

model TradingSymbol {
  id            String   @id @default(cuid())
  symbol        String   @unique              // Binance format: ETHUSDT
  okxId         String                        // OKX format: ETH-USDT
  label         String                        // Display: ETH/USDT
  baseAsset     String                        // ETH
  quoteAsset    String   @default("USDT")     // USDT
  pricePrecision Int     @default(2)          // 价格精度
  qtyPrecision  Int      @default(4)          // 数量精度
  minQty        Float    @default(0)          // 最小下单量
  minNotional   Float    @default(5)          // 最小名义价值
  active        Boolean  @default(true)       // 是否前台显示/可手动查看
  autoTrade     Boolean  @default(false)      // 是否允许自动交易引擎开仓
  isPopular     Boolean  @default(false)      // 是否热门（排序靠前）
  sortOrder     Int      @default(0)          // 排序权重
  iconUrl       String?                       // 币种图标
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([autoTrade])
  @@index([isPopular])
  @@index([sortOrder])
}

// ==================== AI 行情分析 ====================

model AiAnalysis {
  id            String   @id @default(cuid())
  symbol        String                         // 交易对 e.g. ETHUSDT
  direction     String                         // 'long' | 'short' | 'neutral'
  confidence    Int                            // 置信度 0-100
  summary       String   @db.Text              // AI 总结
  entryPrice    Float?                         // 建议入场价
  stopLoss      Float?                         // 建议止损价
  takeProfit1   Float?                         // 止盈1
  takeProfit2   Float?                         // 止盈2
  reasoning     String   @db.Text              // 详细分析逻辑
  keyLevels     String?                        // 关键价位 JSON
  riskWarning   String?                        // 风险提示
  provider      String?                        // 使用的 AI 供应商
  model         String?                        // 使用的模型名称
  rawResponse   String?  @db.Text              // 原始响应（调试用）
  createdAt     DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@index([direction])
}
