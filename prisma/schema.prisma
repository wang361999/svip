generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  username         String        @unique
  password         String
  role             String        @default("user")
  membership       String        @default("free")
  membershipExpires String?
  strategyConfig   String?
  // 用户画线偏好
  prefAB9          String        @default("true")
  prefAB9Labels    String        @default("true")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tradeRecords     TradeRecord[]
  priceAlerts      PriceAlert[]
}

model TradeRecord {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  side         String
  entryPrice   Float
  exitPrice    Float?
  stopLoss     Float?
  takeProfit1  Float?
  takeProfit2  Float?
  volume       Float
  status       String    @default("open")
  pnl          Float     @default(0)
  pnlPercent   Float     @default(0)
  strategy     String?
  note         String?
  timestamp    DateTime  @default(now())
  closedAt     DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String
  expiry    DateTime
  lastSent  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type])
}

model PriceAlert {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  condition    String
  targetPrice  Float
  note         String?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  triggeredAt  DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RedeemCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  days      Int
  used      Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([used])
}

model SiteSetting {
  id                     String   @id @default("main")
  // 基础信息
  siteTitle              String   @default("ETH Trading Tool")
  siteSubtitle           String   @default("Real-time Ethereum Trading Platform")
  siteLogo               String   @default("/logo.svg")
  footerText             String   @default("© 2024 ETH Trading Tool. All rights reserved.")
  primaryColor           String   @default("#3b82f6")
  // 指标开关
  indicatorEMA           String   @default("false")
  indicatorBOLL          String   @default("true")
  indicatorMACD          String   @default("true")
  indicatorRSI           String   @default("false")
  indicatorATR           String   @default("false")
  // 指标周期参数
  emaPeriod              String   @default("20")
  bollPeriod             String   @default("20")
  rsiPeriod              String   @default("14")
  atrPeriod              String   @default("14")
  macdFast               String   @default("12")
  macdSlow               String   @default("26")
  macdSignal             String   @default("9")
  // 显示控制
  showPriceCard          String   @default("true")
  enableRegistration     String   @default("true")
  // SMTP 邮箱配置
  smtpHost               String?  @default("smtp.qq.com")
  smtpPort               String?  @default("465")
  smtpSecure             String?  @default("true")
  smtpUser               String?
  smtpPass               String?
  smtpFrom               String?

  updatedAt              DateTime @updatedAt
}

// ==================== 交易币种管理 ====================

model TradingSymbol {
  id            String   @id @default(cuid())
  symbol        String   @unique              // Binance format: ETHUSDT
  okxId         String                        // OKX format: ETH-USDT
  label         String                        // Display: ETH/USDT
  baseAsset     String                        // ETH
  quoteAsset    String   @default("USDT")     // USDT
  pricePrecision Int     @default(2)          // 价格精度
  qtyPrecision  Int      @default(4)          // 数量精度
  minQty        Float    @default(0)          // 最小下单量
  minNotional   Float    @default(5)          // 最小名义价值
  active        Boolean  @default(true)       // 是否前台显示/可手动查看
  autoTrade     Boolean  @default(false)      // 是否允许自动交易引擎开仓
  isPopular     Boolean  @default(false)      // 是否热门（排序靠前）
  sortOrder     Int      @default(0)          // 排序权重
  iconUrl       String?                       // 币种图标
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([autoTrade])
  @@index([isPopular])
  @@index([sortOrder])
}
