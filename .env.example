# ===== 环境变量模板 =====
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
# 线上部署请配置到 Vercel Dashboard → Settings → Environment Variables

# 数据库连接串（Neon / 自建 PostgreSQL）
# Neon 示例：postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# JWT 签名密钥 — 必填，生产环境缺失会拒绝启动
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# /init 页面初始化密钥（首次建库后建议关闭该页面访问）
INIT_KEY=

# AI 结构分析（OpenAI 兼容协议，换厂商只改这三项）
# DeepSeek 示例：BASE_URL=https://api.deepseek.com  MODEL=deepseek-chat
# 硅基流动示例：BASE_URL=https://api.siliconflow.cn/v1  MODEL=Qwen/Qwen2.5-7B-Instruct
# 未配置时自动降级为模板文案，页面功能不受影响
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 应用对外地址（可选，用于邮件链接等）
NEXT_PUBLIC_APP_URL=
